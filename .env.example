# Copy to .env in the repository root for Docker Compose.
# Generate strong values, never reuse the examples:
#   SECRET_KEY:        openssl rand -hex 32
#   POSTGRES_PASSWORD: openssl rand -hex 32

ENVIRONMENT=development
# Fresh Compose cluster only: three DIFFERENT URL-safe values (hex recommended).
POSTGRES_PASSWORD=replace-with-a-random-administrator-password
DB_APP_PASSWORD=replace-with-a-different-random-application-password
DB_MIGRATION_PASSWORD=replace-with-a-different-random-migration-password
APP_IMAGE_TAG=local
WEB_BIND_ADDRESS=127.0.0.1
# Exact Compose public hostnames (space-separated, no schemes/ports); localhost
# entries preserve health checks. Rebuild web after changing this value.
NGINX_SERVER_NAMES=localhost 127.0.0.1
# Optional API defence in depth (comma-separated exact hostnames, no ports).
ALLOWED_HOSTS=
SECRET_KEY=replace-with-a-random-key-of-at-least-32-characters
SECURE_COOKIES=false
CORS_ORIGINS=http://localhost:8080
# Only the private proxy network may assert a client address. Leave blank when the
# API is reachable directly (the transport address is then used).
TRUSTED_PROXY_IPS=172.28.0.0/16

# Token/password lifecycle and sign-in budgets.
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
PASSWORD_MAX_AGE_DAYS=90
PASSWORD_EXPIRY_WARNING_DAYS=14
PASSWORD_HISTORY_LIMIT=5
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
FORCE_PASSWORD_CHANGE_ON_CREATE=true
# Keep aligned with frontend/nginx.conf backup-import client_max_body_size.
BACKUP_MAX_UPLOAD_MB=2048

# Entry checks on the daily cost sheet: unusual quantities, rates, exchange rates
# and depths are pointed out before saving. Arithmetic over the workspace's own
# sheets only: no model and no outside service. They never block a save.
ENTRY_CHECKS_ENABLED=true
# Sheets of the same AFE, nearest in date, a sheet is compared with (5-120).
ENTRY_CHECK_HISTORY_SHEETS=30
# Workspace item profiles: how far back they read (30-3650 days) and how long
# one is used before it is rebuilt (1-720 hours).
ENTRY_CHECK_PROFILE_WINDOW_DAYS=730
ENTRY_CHECK_PROFILE_MAX_AGE_HOURS=24

# Offline LAN AI model (Ollama running on another machine on the same LAN or locally).
# Off by default so every screen runs deterministically until enabled. On the Ollama
# machine: expose Ollama to the LAN (`OLLAMA_HOST=0.0.0.0:11434`), allow TCP 11434 from
# this host in the firewall, and pull the model (`ollama pull qwen3:4b-q4_K_M`).
# In Docker Compose, start with `docker compose -f docker-compose.yml -f docker-compose.ollama.yml up -d`
# (or `make up-ai`) so the API container can reach the LAN while PostgreSQL stays isolated.
OLLAMA_ENABLED=false
# Replace 127.0.0.1 with the Ollama machine's LAN IP (for example http://192.168.1.50:11434).
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Generation and model-discovery endpoints (/api/chat + /api/tags, or /v1/chat/completions + /v1/models).
OLLAMA_API_PATH=/api/chat
OLLAMA_TAGS_PATH=/api/tags
# Optional compact model: OLLAMA_MODEL=qwen3:0.6b. See docs/ai-knowledge.md for PDF references.
OLLAMA_MODEL=qwen3:4b-q4_K_M
# Optional sampling controls for Qwen3 factual grounding.
OLLAMA_TOP_P=0.9
OLLAMA_REPEAT_PENALTY=1.08
# Optional Bearer token when the remote Ollama host sits behind an authenticated proxy.
OLLAMA_API_KEY=
# TCP connect timeout (1-60s) for fast offline detection and inference timeout (5-300s).
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
OLLAMA_TIMEOUT_SECONDS=90
# Generation tuning: low temperature keeps database figures factual; OLLAMA_THINK=false
# suppresses slow Qwen3 reasoning chains for fast LAN answers.
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_CTX=8192
OLLAMA_MAX_TOKENS=1200
OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=15m
# Optional path to a PEM CA certificate bundle when OLLAMA_BASE_URL uses https://.
OLLAMA_CA_CERT=

# Optional unattended first boot: the API seeds this administrator if the database has none.
# Leave blank to be asked interactively (`docker compose exec -it api python -m app.seed`).
# Clear SEED_ADMIN_PASSWORD again once the first start has completed.
SEED_ORG_SLUG=
SEED_ORG_NAME=
SEED_OWNER_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Optional PDF reference indexes for a native API. Docker uses docker-compose.ai-knowledge.yml.
# AI_KNOWLEDGE_DIRECTORY=/path/to/ai-knowledge
# AI_KNOWLEDGE_HOST_DIRECTORY=./ai-knowledge

# Actual ASGI byte caps (edge limits are additional protection).
MAX_JSON_BODY_MB=10
# Aggregate multipart cap, including all files and form overhead.
MAX_MULTIPART_BODY_MB=128
# Backup import retains BACKUP_MAX_UPLOAD_MB plus 1 MiB multipart overhead.
