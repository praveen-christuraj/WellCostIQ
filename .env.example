# Copy to .env in the repository root for Docker Compose.
# Generate strong values, never reuse the examples:
#   SECRET_KEY:        openssl rand -hex 32
#   POSTGRES_PASSWORD: openssl rand -hex 32

ENVIRONMENT=development
# Fresh Compose cluster only: three DIFFERENT URL-safe values (hex recommended).
POSTGRES_PASSWORD=replace-with-a-random-administrator-password
DB_APP_PASSWORD=replace-with-a-different-random-application-password
DB_MIGRATION_PASSWORD=replace-with-a-different-random-migration-password
APP_IMAGE_TAG=local
WEB_BIND_ADDRESS=127.0.0.1
# Exact Compose public hostnames (space-separated, no schemes/ports); localhost
# entries preserve health checks. Rebuild web after changing this value.
NGINX_SERVER_NAMES=localhost 127.0.0.1
# Optional API defence in depth (comma-separated exact hostnames, no ports).
ALLOWED_HOSTS=
SECRET_KEY=replace-with-a-random-key-of-at-least-32-characters
SECURE_COOKIES=false
CORS_ORIGINS=http://localhost:8080
# Only the private proxy network may assert a client address. Leave blank when the
# API is reachable directly (the transport address is then used).
TRUSTED_PROXY_IPS=172.28.0.0/16

# Token/password lifecycle and sign-in budgets.
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
PASSWORD_MAX_AGE_DAYS=90
PASSWORD_EXPIRY_WARNING_DAYS=14
PASSWORD_HISTORY_LIMIT=5
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
FORCE_PASSWORD_CHANGE_ON_CREATE=true
# Keep aligned with frontend/nginx.conf backup-import client_max_body_size.
BACKUP_MAX_UPLOAD_MB=2048

# Entry checks on the daily cost sheet: unusual quantities, rates, exchange rates
# and depths are pointed out before saving. Arithmetic over the workspace's own
# sheets only: no model and no outside service. They never block a save.
ENTRY_CHECKS_ENABLED=true
# Sheets of the same AFE, nearest in date, a sheet is compared with (5-120).
ENTRY_CHECK_HISTORY_SHEETS=30
# Workspace item profiles: how far back they read (30-3650 days) and how long
# one is used before it is rebuilt (1-720 hours).
ENTRY_CHECK_PROFILE_WINDOW_DAYS=730
ENTRY_CHECK_PROFILE_MAX_AGE_HOURS=24

# Optional unattended first boot: the API seeds this administrator if the database has none.
# Leave blank to be asked interactively (`docker compose exec -it api python -m app.seed`).
# Clear SEED_ADMIN_PASSWORD again once the first start has completed.
SEED_ORG_SLUG=
SEED_ORG_NAME=
SEED_OWNER_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
