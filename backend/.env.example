# Copy to backend/.env for a local `uvicorn app.main:app` run.
# Generate values, never reuse the examples:
#   SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"

ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://wellcosting_app:replace-with-a-url-encoded-password@localhost:5432/wellcosting
SECRET_KEY=replace-with-a-long-cryptographically-random-secret
SECURE_COOKIES=false
CORS_ORIGINS=http://localhost:5173
# Optional comma-separated exact Host names (no schemes, ports or wildcards).
ALLOWED_HOSTS=
# Comma-separated proxy addresses/CIDRs whose X-Forwarded-For may be believed.
TRUSTED_PROXY_IPS=

# Password lifecycle (0 disables age expiry — only with an external identity provider).
PASSWORD_MAX_AGE_DAYS=90
PASSWORD_EXPIRY_WARNING_DAYS=14
PASSWORD_HISTORY_LIMIT=5
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# A new account must choose its own password on first sign-in (defaults to true in production).
FORCE_PASSWORD_CHANGE_ON_CREATE=true

# Offline LAN AI model (Ollama on another PC in the same LAN or on localhost).
# Set OLLAMA_ENABLED=true and point OLLAMA_BASE_URL at the Ollama PC's LAN IP
# (for example http://192.168.1.50:11434). On that PC set OLLAMA_HOST=0.0.0.0:11434,
# allow TCP 11434 in the firewall, and run: ollama pull qwen3:4b-q4_K_M
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_API_PATH=/api/chat
OLLAMA_TAGS_PATH=/api/tags
OLLAMA_MODEL=qwen3:4b-q4_K_M
OLLAMA_API_KEY=
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_CTX=8192
OLLAMA_MAX_TOKENS=1200
OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=15m
OLLAMA_CA_CERT=

# Optional unattended first boot: seeded when the database has no administrator.
BOOTSTRAP_ADMIN_ON_STARTUP=true
SEED_ORG_SLUG=
SEED_ORG_NAME=
SEED_OWNER_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
